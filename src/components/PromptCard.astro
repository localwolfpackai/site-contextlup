---
import { agentPrompt } from '../lib/protocol';

/**
 * The one-line prompt, presented as the primary artifact it is: a clean,
 * prominent, copy-to-clipboard card. This is the site's main CTA — the thing
 * a human pastes into an agent instead of re-explaining themselves.
 */
interface Props {
  /** Visual emphasis. "hero" gets the larger, framed treatment. */
  variant?: 'hero' | 'inline';
}

const { variant = 'inline' } = Astro.props;

// Absolute prompt text, built from the live origin (falls back to the domain).
const origin = Astro.site?.href.replace(/\/$/, '') ?? 'https://contextlup.com';
const prompt = agentPrompt(origin);
---

<figure class:list={['prompt-card', `prompt-card--${variant}`]}>
  <figcaption class="prompt-card__label">
    <span class="prompt-card__dot" aria-hidden="true"></span>
    The one-line prompt
  </figcaption>

  <div class="prompt-card__body">
    <p class="prompt-card__text" data-prompt>{prompt}</p>

    <button type="button" class="prompt-card__copy" data-copy-prompt aria-label="Copy the prompt">
      <svg class="prompt-card__icon prompt-card__icon--copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <svg class="prompt-card__icon prompt-card__icon--check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
      <span class="prompt-card__copy-label">Copy</span>
    </button>
  </div>
</figure>

<script>
  // Wire every prompt card on the page. Pure DOM, no framework.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((button) => {
    const card = button.closest('.prompt-card');
    const text = (card?.querySelector<HTMLElement>('[data-prompt]')?.textContent ?? '').trim();
    const label = button.querySelector('.prompt-card__copy-label');

    // Try the modern async clipboard; fall back to execCommand for restricted
    // contexts (older browsers, some sandboxes). Returns whether either worked.
    async function copyText(value: string): Promise<boolean> {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        /* fall through to the legacy path */
      }
      try {
        const ta = document.createElement('textarea');
        ta.value = value;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        // HACK: execCommand('copy') is deprecated (TS flags it as a hint) but
        // remains the only clipboard path in some restricted contexts. Kept as a
        // deliberate fallback after navigator.clipboard fails. TODO: drop when
        // the async Clipboard API is universally reachable in our targets.
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      } catch {
        return false;
      }
    }

    function confirmCopied(): void {
      button.classList.add('is-copied');
      if (label) label.textContent = 'Copied';
      window.setTimeout(() => {
        button.classList.remove('is-copied');
        if (label) label.textContent = 'Copy';
      }, 1800);
    }

    button.addEventListener('click', async () => {
      if (await copyText(text)) confirmCopied();
    });
  });
</script>
